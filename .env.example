# Clave para entrar en /panel. Sin ella el panel no deja iniciar sesión.
NUXT_ADMIN_KEY=cambia-esta-clave

# Secreto para firmar la cookie de sesión del panel (32 caracteres o más).
NUXT_SESSION_PASSWORD=pon-aqui-un-secreto-largo-de-al-menos-32-caracteres

# Carpeta donde se guardan la partida en curso, el historial, los conjuntos,
# los lotes de cartones y el logo. En Docker es el volumen /data.
NUXT_DATA_DIR=./.data/bingo
