# ─── Aplicación ────────────────────────────────────────────────────────────
# Si un valor lleva $, # o espacios, escríbelo entre comillas simples: '...'

# Clave para entrar en /panel. Mientras esté vacía, el panel no deja entrar.
# Genera una con: openssl rand -hex 16
NUXT_ADMIN_KEY=

# Secreto para firmar la cookie de sesión del panel (32 caracteres o más).
# Genera uno con: openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# Carpeta donde se guardan la partida en curso, el historial, los conjuntos,
# los lotes de cartones y el logo (por defecto ./.data/bingo). En Docker se
# ignora (siempre es /data) y el servicio systemd usa /var/lib/bingo: no la
# definas salvo para cambiarla.
# NUXT_DATA_DIR=./.data/bingo

# ─── Docker Compose (solo para docker-compose.yml) ─────────────────────────

# Dominio para el HTTPS automático de Caddy (docker compose --profile caddy).
# BINGO_DOMAIN=bingo.example.com

# Dónde publica el contenedor su puerto. 127.0.0.1 = solo para un proxy en el
# mismo servidor; 0.0.0.0 = accesible por la IP del servidor (sin dominio).
# BINGO_BIND=127.0.0.1
# BINGO_PORT=3000

# Zona horaria del proceso. Las horas del panel se muestran en la del
# navegador que lo abre.
# TZ=Europe/Madrid
